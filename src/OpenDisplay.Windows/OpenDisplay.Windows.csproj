<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>OpenDisplayReceiver</AssemblyName>
    <RootNamespace>OpenDisplay.Windows</RootNamespace>
    <Product>OpenDisplay Receiver for Windows</Product>
    <Version>0.1.4</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenDisplay.Core\OpenDisplay.Core.csproj" />
  </ItemGroup>
</Project>
